# Copy this file to .env and fill in the two values from your Supabase project
# (Project Settings, API). Leave them empty to run the waitlist form in mock mode.
# The anon key is public by design: row level security only allows inserts with consent.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Also accepted (the names Supabase's Vercel integration creates):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
